#
#
script:
# Update each second  ##################
  - id: time_update
    then:
      - lvgl.label.update:
          id: time_header
          text:
            format: "%s"
            args: [ 'id(nice_date).state.c_str()' ]              
#
# Page 1 Page 1 Page 1 Page 1 Page 1 Page 1 Page 1 Page 1 
#
      - lvgl.label.update:
          id: page1_time_ist
          text:
            format: "IST %s"
            args: [ 'id(ha_clock_ist).state.c_str()' ]
      - lvgl.label.update:
          id: page1_time_utc
          text:
            format: "UTC %02d:%02d"
            args: [ 'id(sntp_time).utcnow().hour', 'id(sntp_time).utcnow().minute' ]            
      - lvgl.label.update:
          id: page1_time_local
          text:
            format: "HKG %s"
            args: [ 'id(ha_clock_local).state.c_str()' ]
#
#
time:
  - platform: sntp
    id: sntp_time
    on_time:
      # flash the LED every hour
      - seconds: 0
        minutes: 0
        hours: /1
        then:
          - light.turn_on:
              id: led
              effect: "Fast Pulse"
          - delay: 5000ms
          - light.turn_off:
              id: led 
  - platform: homeassistant
    id: homeassistant_time
    on_time_sync:
      - script.execute: time_update
    on_time:
      - minutes: '*'
        seconds: '*'
        then:
          - script.execute: time_update
  - platform: homeassistant
    id: time_minute
    on_time_sync:
      - lvgl.page.show:
          id: page1
      - logger.log:
          format: "[Rob] Time Sync Time Sync Time Sync Time Sync Time Sync Time Sync"
          level: WARN        
    on_time:
      - minutes: '*'
        then:
          #- script.execute: time_minute_update
#          
#
