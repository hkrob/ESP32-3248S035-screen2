                          event: esphome.officeCYD.goingout
                          data:
                            title: officeCYD.goingout
                      #- event.trigger:
                      #    id: going_out_button_event
                      #    event_type: going_out_button


#
    - id: page1
      widgets:
        - obj:
            bg_color: 0x000000
            border_width: 0
